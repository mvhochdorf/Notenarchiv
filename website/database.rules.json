{
  "rules": {
    "notenarchiv": {
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "catalog": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('notenarchiv/admins/' + auth.uid).val() === true",
        "$songId": {
          ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true && !data.exists() && newData.child('addedBy').val() === root.child('notenarchiv/users/' + auth.uid + '/personId').val()",
          ".validate": "newData.hasChildren(['title', 'added'])",
          "number": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "genre": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "occasion": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "solo": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "composer": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "arranger": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "publisher": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "folderNumber": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "collection": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "added": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "video": {
            ".validate": "newData.hasChildren(['videoId', 'start'])",
            "videoId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/)"
            },
            "start": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "duration": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "peak": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "$other": {
              ".validate": false
            }
          },
          "noVideo": {
            ".validate": "newData.val() === true"
          },
          "addedBy": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{3,100}$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "ratings": {
        ".read": "auth != null",
        "$songId": {
          "$personId": {
            ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true && root.child('notenarchiv/users/' + auth.uid + '/personId').val() === $personId",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5 && newData.val() % 1 === 0"
          }
        }
      },
      "media": {
        ".read": "auth != null",
        "$songId": {
          ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true",
          ".validate": "newData.hasChildren(['videoId', 'start'])",
          "videoId": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{11}$/)"
          },
          "start": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "likes": {
        ".read": "auth != null",
        "$songId": {
          "$personId": {
            ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true && root.child('notenarchiv/users/' + auth.uid + '/personId').val() === $personId",
            ".validate": "newData.val() === true"
          }
        }
      },
      "saved": {
        ".read": "auth != null",
        "$songId": {
          "$personId": {
            ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true && root.child('notenarchiv/users/' + auth.uid + '/personId').val() === $personId",
            ".validate": "newData.val() === true"
          }
        }
      },
      "comments": {
        ".read": "auth != null",
        "$songId": {
          "$commentId": {
            ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true && ((!data.exists() && newData.child('person').val() === root.child('notenarchiv/users/' + auth.uid + '/personId').val()) || (data.exists() && !newData.exists() && data.child('person').val() === root.child('notenarchiv/users/' + auth.uid + '/personId').val()))",
            ".validate": "newData.hasChildren(['person', 'name', 'text', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 81"
            },
            "person": {
              ".validate": "newData.isString()"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "views": {
        ".read": "auth != null",
        "$songId": {
          "$personId": {
            ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true && root.child('notenarchiv/users/' + auth.uid + '/personId').val() === $personId",
            ".validate": "newData.val() === true"
          }
        }
      },
      "news": {
        ".read": "auth != null",
        "$songId": {
          "$personId": {
            ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true && root.child('notenarchiv/users/' + auth.uid + '/personId').val() === $personId",
            "like": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "rating": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "added": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "users": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && root.child('notenarchiv/maintenance/on').val() !== true && auth.uid === $uid",
          ".validate": "newData.hasChildren(['firstName', 'lastName', 'personId', 'at'])",
          "firstName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "lastName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "personId": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{3,100}$/)"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "reports": {
        ".read": "auth != null",
        "$songId": {
          "$commentId": {
            ".write": "auth != null && ((root.child('notenarchiv/maintenance/on').val() !== true && ((!data.exists() && newData.child('person').val() === root.child('notenarchiv/users/' + auth.uid + '/personId').val()) || (data.exists() && !newData.exists() && data.child('person').val() === root.child('notenarchiv/users/' + auth.uid + '/personId').val()))) || (data.exists() && !newData.exists() && root.child('notenarchiv/admins/' + auth.uid).val() === true))",
            ".validate": "newData.hasChildren(['person', 'name', 'text', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 81"
            },
            "person": {
              ".validate": "newData.isString()"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "maintenance": {
        ".read": true,
        ".write": false,
        "on": {
          ".validate": "newData.isBoolean()"
        },
        "message": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
